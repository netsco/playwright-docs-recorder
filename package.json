{
  "name": "doc-recorder",
  "version": "2.0.0",
  "description": "Record browser actions with on-demand screenshots and element highlighting for documentation",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "record": "node packages/cli/index.js",
    "desktop": "npm run dev -w @doc-recorder/desktop",
    "desktop:build": "npm run build -w @doc-recorder/desktop"
  }
}
