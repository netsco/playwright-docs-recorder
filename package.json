{
  "name": "doc-recorder",
  "version": "0.4.0",
  "description": "Record browser actions with on-demand screenshots and element highlighting for documentation",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/netsco/playwright-docs-recorder.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "record": "node packages/cli/index.js",
    "desktop": "npm run dev -w @doc-recorder/desktop",
    "desktop:build": "npm run build -w @doc-recorder/desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"packages/**/*.js\"",
    "lint:fix": "eslint \"packages/**/*.js\" --fix",
    "changeset": "changeset",
    "version": "changeset version",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "memfs": "^4.57.8",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "vitest related --run"
    ]
  },
  "dependencies": {
    "electron": "^43.0.0"
  },
  "overrides": {
    "vite": "^8.0.14"
  }
}
