{
  "name": "@doc-recorder/desktop",
  "version": "0.5.1",
  "description": "Desktop app for recording browser interactions with screenshots for documentation",
  "main": "src/main/main.js",
  "scripts": {
    "css:build": "npx @tailwindcss/cli -i ./src/renderer/styles/input.css -o ./src/renderer/styles/output.css",
    "css:watch": "npx @tailwindcss/cli -i ./src/renderer/styles/input.css -o ./src/renderer/styles/output.css --watch",
    "start": "npm run css:build && electron .",
    "dev": "npm run css:build && electron . --dev",
    "build": "npm run css:build && electron-builder",
    "build:win": "npm run css:build && electron-builder --win",
    "build:mac": "npm run css:build && electron-builder --mac",
    "build:linux": "npm run css:build && electron-builder --linux",
    "pack": "npm run css:build && electron-builder --dir"
  },
  "author": {
    "name": "netsco",
    "email": "netsco@users.noreply.github.com"
  },
  "homepage": "https://github.com/netsco/playwright-docs-recorder",
  "license": "MIT",
  "dependencies": {
    "@doc-recorder/shared": "0.3.0",
    "electron-store": "^8.1.0",
    "marked": "^17.0.1",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18"
  }
}
