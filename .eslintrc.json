{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "semi": ["error", "always"],
    "quotes": ["error", "single", { "avoidEscape": true }]
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "coverage/",
    "packages/desktop/src/renderer/styles/output.css"
  ],
  "overrides": [
    {
      "files": ["**/__tests__/**/*.js"],
      "env": {
        "jest": true
      },
      "rules": {
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["vitest.config.js"],
      "parserOptions": {
        "sourceType": "module"
      }
    },
    {
      "files": ["packages/cli/index.js", "packages/shared/refetch.js", "packages/desktop/src/shared/**/*.js"],
      "globals": {
        "window": "readonly",
        "document": "readonly"
      }
    },
    {
      "files": ["packages/desktop/src/renderer/**/*.js", "packages/desktop/src/webview/**/*.js"],
      "env": {
        "browser": true
      }
    }
  ]
}
